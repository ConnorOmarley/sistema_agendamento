# =============================================================
# .env.example — Template de variáveis de ambiente do Acompanha
# =============================================================
# Copie este arquivo para .env.local e preencha cada variável com
# os valores reais. NUNCA commite o .env.local (já está no .gitignore).
#
# Variáveis prefixadas com NEXT_PUBLIC_ são expostas ao browser.
# As demais ficam só no servidor (rotas API, server components).


# -------------------------------------------------------------
# Supabase — banco de dados, auth, RLS
# Dashboard: https://supabase.com/dashboard/project/<projeto>/settings/api
# -------------------------------------------------------------

# URL do projeto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key — usada no client (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypassa RLS. SO server-side (webhook, rotas admin).
# (Settings → API → service_role / secret). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=


# -------------------------------------------------------------
# Resend — envio transacional de e-mail
# https://resend.com → API Keys
# -------------------------------------------------------------

# API key (formato re_xxxxxxxx)
RESEND_API_KEY=

# Remetente. Use onboarding@resend.dev em dev (sem precisar verificar domínio).
# Em produção, troque por contato@seudominio.com.br com DNS validado.
RESEND_FROM_EMAIL=onboarding@resend.dev

# URL da API Resend. Raramente muda; útil pra proxy/mock em testes.
RESEND_API_URL=https://api.resend.com/emails


# -------------------------------------------------------------
# Asaas — gateway de pagamento BR
# https://www.asaas.com (prod) ou https://sandbox.asaas.com (testes)
# -------------------------------------------------------------

# Base URL — sandbox em dev, api.asaas.com em produção
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# API key (Asaas Dashboard → Integrações → API)
ASAAS_API_KEY=

# Token do webhook (Asaas Dashboard → Integrações → Webhooks → criar)
# Eventos a marcar: PAYMENT_RECEIVED, PAYMENT_CONFIRMED, PAYMENT_OVERDUE,
# PAYMENT_CHARGEBACK_REQUESTED, PAYMENT_CHARGEBACK_DISPUTE,
# PAYMENT_REFUNDED, SUBSCRIPTION_DELETED
ASAAS_WEBHOOK_TOKEN=


# -------------------------------------------------------------
# Sentry — monitoramento de erros (opcional)
# https://sentry.io
# -------------------------------------------------------------

# Sem DSN, src/lib/monitoring.ts cai pra console.error.
# Quando ativar: npm install @sentry/nextjs e atualizar monitoring.ts.
SENTRY_DSN=


# -------------------------------------------------------------
# Controlador LGPD — dados PÚBLICOS exibidos em /termos e /privacidade
# Não são secrets, mas centralizados aqui pra mudar em 1 lugar.
# Lidos por src/lib/controlador.ts.
# -------------------------------------------------------------

# Nome completo / razão social do controlador dos dados
CONTROLADOR_NOME=

# 'pessoa física' ou 'pessoa jurídica'
CONTROLADOR_TIPO_PESSOA=pessoa física

# Documento legal (ex: 'CPF 000.000.000-00' ou 'CNPJ 00.000.000/0000-00')
CONTROLADOR_DOCUMENTO=

# Cidade/UF do controlador
CONTROLADOR_LOCALIZACAO=

# E-mail oficial / DPO (para titulares exercerem direitos LGPD)
CONTROLADOR_EMAIL=
